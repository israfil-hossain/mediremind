# Firebase Configuration
# Get these from your Firebase Console > Project Settings > General > Your apps
# For iOS/Android: Download GoogleService-Info.plist / google-services.json
# For Web Client ID: Go to Google Cloud Console > APIs & Services > Credentials
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Stripe Publishable Key
# Get this from Stripe Dashboard > Developers > API keys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Firebase Project Config
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# AdMob Configuration
# Get these from your AdMob Console (https://apps.admob.com/)
# App IDs (NOT ad unit IDs - these are the app-level IDs)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY

# Ad Unit IDs
# Banner Ad Unit IDs (bottom of screen ads)
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ

# Interstitial Ad Unit IDs (full-screen ads)
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ

# Development: Override premium status for testing (true/false)
# Set to 'true' to test premium features without a subscription
EXPO_PUBLIC_DEV_IS_PREMIUM=false

# Resend API Key for Email Notifications
# Get this from Resend Dashboard > API Keys
# Used for sending missed medication alerts to family members
RESEND_API_KEY=re_your_resend_api_key
